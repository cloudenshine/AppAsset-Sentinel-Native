<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\AppAssetSentinel.Core\AppAssetSentinel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <None Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    AUDIT A26: the program loads rules/ from disk at runtime, so the rules must be part of
    the published output. Declaring them as Content with CopyToPublishDirectory guarantees
    they land beside the executable; a None item with only CopyToOutputDirectory reached the
    build output but was silently dropped from `dotnet publish`, which made a standalone
    install unable to find its own rules.
  -->
  <ItemGroup>
    <Content Include="..\..\rules\*.json"
             Link="rules\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Audit warnings are useful during development but do not block a release build. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

</Project>
